# Set at least one of these two.
# Gemini (free, no card): https://aistudio.google.com/apikey  -> Gemini Live voice + Gemini Flash vision
GOOGLE_API_KEY=
# Anthropic: https://console.anthropic.com  -> Claude Haiku 5.5 (vision, and the agent when there is no Google key)
ANTHROPIC_API_KEY=

# Optional overrides. Default: gemini if GOOGLE_API_KEY is set, else claude.
# AGENT_PROVIDER=gemini      # who talks: gemini (Live audio) or claude (phone's own speech + Claude)
# VISION_PROVIDER=gemini     # who reads the frames: gemini or claude

# Price sources. Without them the system still runs, but books/items get "no price found"
# (blank, excluded from totals, sent to review) - it never guesses.
# SerpAPI (optional, adds Google Shopping retail prices): https://serpapi.com/manage-api-key
SERPAPI_KEY=
# eBay Browse API, free, needed for prices. Use your own Production keyset; see README "get your own eBay keys".
# https://developer.ebay.com/my/keys  ->  App ID = EBAY_CLIENT_ID, Cert ID = EBAY_CLIENT_SECRET
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Policyholder locale. Supported: US, GB, CA, AU
COUNTRY=US
CURRENCY=USD

# Optional
# LIVE_MODEL=gemini-3.8-live
# VISION_MODEL=gemini-3.8-flash
# VOICE=Kore
# APPRAISAL_THRESHOLD=150
# ACCESS_TOKEN=pick-a-random-string   # require ?token=... when exposed through a tunnel
